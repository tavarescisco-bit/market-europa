---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { store, todayHours } from '../lib/content';
import { u } from '../lib/url';
import { liveSpecials, campaigns, fmtRange } from '../lib/specials';

interface Props { title: string; description: string; current?: string; schema?: object | object[]; noindex?: boolean; ogImage?: string }
const { title, description, current = '', schema, noindex = false, ogImage } = Astro.props;

const today = todayHours();
const live = liveSpecials();
const mainCampaign = campaigns(live).find((c) => c.items.some((i) => !i.liquor)) ?? campaigns(live)[0];
const specialsEnd = mainCampaign ? fmtRange(mainCampaign.start, mainCampaign.end).split('–')[1].trim() : '';
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const abs = (p: string) => (siteUrl ? siteUrl + u(p) : u(p));

const storeSchema = {
  '@context': 'https://schema.org',
  '@type': 'GroceryStore',
  name: store.name,
  image: abs('/og.png'),
  logo: abs('/brand/logo-compact.png'),
  telephone: '+61 3 9558 0755',
  url: abs('/'),
  priceRange: '$$',
  address: { '@type': 'PostalAddress', streetAddress: `${store.address.line1}, ${store.address.centre}`, addressLocality: store.address.locality, addressRegion: store.address.region, postalCode: store.address.postcode, addressCountry: 'AU' },
  geo: { '@type': 'GeoCoordinates', latitude: store.address.lat, longitude: store.address.lng },
  openingHoursSpecification: store.hours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.day, opens: h.open, closes: h.close })),
  sameAs: [store.social.facebook, store.social.instagram],
  department: { '@type': 'CafeOrCoffeeShop', name: 'Market Europa Café', servesCuisine: 'Italian', openingHoursSpecification: store.cafeHours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.open, closes: h.close })) },
};
const schemas = [storeSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
const nav = [['/specials', 'Specials'], ['/departments', 'Departments'], ['/cafe', 'Café'], ['/christmas', 'Christmas'], ['/visit', 'Visit'], ['/about', 'Our story']];
const fullTitle = `${title} · Market Europa Moorabbin`;
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={abs(Astro.url.pathname)}>
  <meta property="og:site_name" content="Market Europa Moorabbin">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={abs(Astro.url.pathname)}>
  <meta property="og:image" content={ogImage ? abs(ogImage) : abs('/og.png')}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#1F4D3A">
  <link rel="icon" href={u('/favicon.png')} type="image/png">
  <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')}>
  <link rel="preload" href={u('/fonts/Fraunces-500.woff2')} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={u('/fonts/DMSans-400.woff2')} as="font" type="font/woff2" crossorigin>
  <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="utility" role="region" aria-label="Store status">
    <div class="container">
      <span><strong>Open today until <span id="close-time">{today.close}</span></strong>{specialsEnd && <> · Specials end {specialsEnd}</>}</span>
      <span><a href={store.mapsUrl} rel="noopener" data-event="directions_click">Directions</a> · <a href={store.phoneHref} data-event="call_click">Call {store.phone}</a></span>
    </div>
  </div>

  <header class="site-header" id="site-header">
    <div class="container">
      <Logo variant="compact" height={64} />
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" id="menu-toggle">Menu</button>
      <nav class="primary" id="primary-nav" aria-label="Primary">
        <ul>{nav.map(([href, label]) => <li><a href={u(href)} aria-current={current === href ? 'page' : undefined}>{label}</a></li>)}</ul>
      </nav>
      <div class="header-cta"><a class="btn btn-primary" href={u('/specials')} data-event="specials_view">This week's specials</a></div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site">
    <div class="container">
      <div class="cols">
        <div>
          <div class="seal"><Logo variant="compact-white-gold" height={64} link={false} /></div>
          {store.foundingYear && <p class="small" style="margin-top:12px">Family-run since {store.foundingYear}</p>}
          <p style="margin-top:16px">{store.address.line1}<br>{store.address.centre}<br>{store.address.locality} {store.address.region} {store.address.postcode}<br>{store.address.parking}</p>
          <p><a href={store.phoneHref} data-event="call_click">{store.phone}</a> · <a href={store.mapsUrl} rel="noopener" data-event="directions_click">Directions</a></p>
          <p><a href={store.social.facebook} rel="noopener">Facebook</a> · <a href={store.social.instagram} rel="noopener">Instagram</a> · <a href={store.sisterStore.url} rel="noopener">{store.sisterStore.name}</a></p>
        </div>
        <div>
          <h3>Store hours</h3>
          <ul>{store.hours.map((h) => <li>{h.day} {h.open} – {h.close}</li>)}</ul>
          <h3 style="margin-top:16px">Café</h3>
          <ul>{store.cafeHours.map((h) => <li>{h.days} {h.open} – {h.close}</li>)}</ul>
        </div>
        <div>
          <h3>Explore</h3>
          <ul>
            <li><a href={u('/specials')}>This week's specials</a></li>
            <li><a href={u('/departments')}>Departments</a></li>
            <li><a href={u('/cafe')}>Café menu</a></li>
            <li><a href={u('/christmas')}>Christmas pre-orders</a></li>
            <li><a href={u('/gnocchi-drop')}>Gnocchi drop</a></li>
            <li><a href={u('/gazette')}>The Gazette</a></li>
            <li><a href={u('/catering')}>Platters and catering</a></li>
            <li><a href={u('/visit')}>Visit</a> · <a href={u('/about')}>Our story</a></li>
            <li><a href={u('/privacy')}>Privacy</a> · <a href={u('/accessibility')}>Accessibility</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <p>Specials are available at Market Europa Moorabbin for the dates shown, while stocks last. Prices include GST. Liquor is sold in store only to people aged 18 and over.{store.liquorLicence && <> Liquor licence {store.liquorLicence}.</>}{store.legalName && <> © {new Date().getFullYear()} {store.legalName}{store.abn && <>, ABN {store.abn}</>}.</>}</p>
      </div>
    </div>
  </footer>

  <nav class="actionbar" aria-label="Quick actions">
    <a href={u('/specials')} class={current === '/specials' ? 'hot' : ''} data-event="specials_view"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 12l-8 8-9-9V3h8l9 9z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>Specials</a>
    <a href={store.mapsUrl} rel="noopener" data-event="directions_click"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s7-7.1 7-12a7 7 0 0 0-14 0c0 4.9 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>Directions</a>
    <a href={store.phoneHref} data-event="call_click"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>Call</a>
    <a href={u('/cafe')} class={current === '/cafe' ? 'hot' : ''}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h12v6a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8z"/><path d="M16 10h2a2 2 0 0 1 0 4h-2M6 2v3M10 2v3"/></svg>Café</a>
  </nav>

  <script define:vars={{ hours: store.hours, analyticsId: store.analyticsId }}>
    // Live "open today until" in Melbourne time, menu toggle, sticky header shrink, analytics events.
    const dow = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].indexOf(new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: 'Australia/Melbourne' }).format(new Date()));
    const h = hours.find(x => x.dow === dow); const ct = document.getElementById('close-time'); if (h && ct) ct.textContent = h.close;
    const t = document.getElementById('menu-toggle'), n = document.getElementById('primary-nav');
    t?.addEventListener('click', () => { const open = n.classList.toggle('open'); t.setAttribute('aria-expanded', String(open)); t.textContent = open ? 'Close' : 'Menu'; });
    const hdr = document.getElementById('site-header');
    const onScroll = () => hdr?.classList.toggle('scrolled', window.scrollY > 24); onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    const send = (name, params) => { window.dataLayer = window.dataLayer || []; window.dataLayer.push({ event: name, ...params }); if (window.gtag) window.gtag('event', name, params || {}); };
    document.addEventListener('click', (e) => { const el = e.target.closest('[data-event]'); if (el) send(el.dataset.event, { href: el.getAttribute('href') || '' }); });
    window.addEventListener('me:event', (e) => send(e.detail.name, e.detail));
    if (analyticsId) { const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + analyticsId; document.head.appendChild(s); window.dataLayer = window.dataLayer || []; window.gtag = function(){ window.dataLayer.push(arguments); }; window.gtag('js', new Date()); window.gtag('config', analyticsId, { anonymize_ip: true }); }
  </script>
</body>
</html>
