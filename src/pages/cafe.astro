---
import Base from '../layouts/Base.astro';
import { store, cafe, departmentBySlug } from '../lib/content';
import { u } from '../lib/url';
const menuSchema = { '@context': 'https://schema.org', '@type': 'Menu', name: `${cafe.name} menu`, hasMenuSection: cafe.sections.map((s) => ({ '@type': 'MenuSection', name: s.title, hasMenuItem: s.items.map((i) => ({ '@type': 'MenuItem', name: i.name, description: i.desc || undefined, offers: { '@type': 'Offer', price: i.price, priceCurrency: 'AUD' } })) })) };
---
<Base title="Café menu: Antonio's fresh gnocchi bar" description="Market Europa Café in Moorabbin: Antonio's fresh gnocchi bar, all-day breakfast, panini and proper coffee. Open daily until 2:30pm, order at the counter." current="/cafe" schema={menuSchema}>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Café</span>
      <h1>{cafe.subtitle}</h1>
      <p class="lede">{cafe.intro}</p>
      <p><strong>Café hours:</strong> {store.cafeHours.map((h) => `${h.days} ${h.open} – ${h.close}`).join(' · ')}. No bookings; order and pay at the counter.</p>
    </div>
  </section>
  <div class="awning" aria-hidden="true"></div>
  <section class="section band-paper">
    <div class="container">
      <div class="menu">
        {cafe.sections.map((s) => (
          <section>
            <h2 class="menu-title">{s.title}</h2>
            <dl>{s.items.map((i) => <><dt><span>{i.name}</span><span class="price">${i.price}</span></dt><dd>{i.desc}{i.takeHome?.length > 0 && <span class="take">Take it home: {i.takeHome.map((slug, k) => { const d = departmentBySlug(slug); return d ? <>{k > 0 && ' · '}<a href={u(`/departments/${slug}`)}>{d.name}</a></> : null; })}</span>}</dd></>)}</dl>
          </section>
        ))}
      </div>
      <p style="margin-top:32px">{cafe.displayWindow}</p>
      <div class="notice">{cafe.allergenNote}{cafe.menuNote && <> {cafe.menuNote}</>}</div>
    </div>
  </section>
</Base>
