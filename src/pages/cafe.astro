---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const cafe = site.cafe;
const menuSchema = { '@context': 'https://schema.org', '@type': 'Menu', name: `${cafe.name} menu`, hasMenuSection: cafe.sections.map(s => ({ '@type': 'MenuSection', name: s.title, hasMenuItem: s.items.map(i => ({ '@type': 'MenuItem', name: i.name, description: i.desc || undefined, offers: { '@type': 'Offer', price: i.price, priceCurrency: 'AUD' } })) })) };
---
<Base title="Café menu" description="Market Europa Café in Moorabbin: Antonio's fresh gnocchi bar, all-day breakfast, panini, coffee. Open daily until 2:30pm." current="/cafe" schema={menuSchema}>
  <div class="wrap section">
    <span class="eyebrow">Café</span>
    <h1>{cafe.name}</h1>
    <p>{cafe.intro}</p>
    <p><strong>Café hours:</strong> {site.cafeHours.map(h => `${h.day} ${h.open} – ${h.close}`).join(' · ')}. Kitchen closes with the café. No bookings; order and pay at the counter.</p>
    <div class="menu" style="margin-top:1.5rem">
      {cafe.sections.map(s => (
        <section>
          <h3>{s.title}</h3>
          <dl>{s.items.map(i => <><dt><span>{i.name}</span><span>${i.price}</span></dt>{i.desc && <dd>{i.desc}</dd>}</>)}</dl>
        </section>
      ))}
    </div>
    <p style="margin-top:1.5rem">{cafe.displayWindow}</p>
    <div class="notice">{cafe.allergenNote}</div>
    <p class="form-note" style="margin-top:1rem">Menu and prices as published by the café in 2025; to be confirmed by the store before launch.</p>
  </div>
</Base>
