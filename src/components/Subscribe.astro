---
/* Email / SMS specials subscription. Posts to the endpoint set in PUBLIC_SUBSCRIBE_URL (Brevo form or a worker).
   Until that is configured the form explains it is not yet live, so no one believes they subscribed. */
const endpoint = import.meta.env.PUBLIC_SUBSCRIBE_URL || '';
---
<section class="section" id="subscribe" aria-labelledby="sub-title">
  <div class="wrap">
    <div class="panel">
      <span class="eyebrow">Specials in your inbox</span>
      <h2 id="sub-title">Get the specials every Monday</h2>
      <p>One email a week with the new specials, and an optional text on Thursdays when the seafood lands. Unsubscribe any time.</p>
      <form class="stack" id="subscribe-form" method="post" action={endpoint || '#'} data-live={endpoint ? 'true' : 'false'}>
        <label>Email <input type="email" name="email" id="sub-email" autocomplete="email" required></label>
        <label>Mobile (optional, for seafood alerts) <input type="tel" name="mobile" id="sub-mobile" autocomplete="tel" inputmode="tel"></label>
        <label class="consent"><input type="checkbox" name="consent_email" id="sub-consent-email" required> Yes, email me Market Europa Moorabbin specials.</label>
        <label class="consent"><input type="checkbox" name="consent_sms" id="sub-consent-sms"> Yes, text me when fresh seafood arrives (at most one text a week).</label>
        <button class="btn" type="submit">Subscribe</button>
        <p class="form-note" id="sub-status">We only use your details to send the specials. You can unsubscribe from every message. [Legal name and ABN to be confirmed.]</p>
      </form>
    </div>
  </div>
</section>
<script>
  const f = document.getElementById('subscribe-form') as HTMLFormElement | null;
  const st = document.getElementById('sub-status');
  f?.addEventListener('submit', (e) => {
    if (f.dataset.live !== 'true') {
      e.preventDefault();
      if (st) st.textContent = 'Subscriptions are not switched on yet on this preview site. Nothing was sent.';
    }
  });
</script>
