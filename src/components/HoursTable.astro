---
import { store, melbourneDow } from '../lib/content';
interface Props { caption?: string }
const { caption = 'Store hours' } = Astro.props;
const dow = melbourneDow();
---
<table class="hours">
  <caption class="eyebrow" style="text-align:left">{caption}</caption>
  <tbody>
    {store.hours.map((h) => <tr class={h.dow === dow ? 'today' : ''}><th scope="row">{h.day}</th><td>{h.open} – {h.close}</td></tr>)}
  </tbody>
</table>
