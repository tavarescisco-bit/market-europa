---
import Base from '../../layouts/Base.astro';
import SpecialCard from '../../components/SpecialCard.astro';
import { u } from '../../lib/url';
import { loadSpecials, campaigns, fmtRange } from '../../lib/specials';

export function getStaticPaths() { return campaigns(loadSpecials()).map((c) => ({ params: { week: c.slug }, props: { c } })); }
const { c } = Astro.props;
const label = c.status === 'live' ? 'On now' : c.status === 'scheduled' ? 'Coming up' : 'Finished';
---
<Base title={`${c.name} specials`} description={`Market Europa Moorabbin specials for ${fmtRange(c.start, c.end)}.`} current="/specials" noindex={c.status !== 'live'}>
  <section class="section">
    <div class="container">
      <span class="eyebrow">{label}</span>
      <h1>{c.name}</h1>
      <p class="lede">{fmtRange(c.start, c.end)} · {c.items.length} offers · <a href={u('/specials')}>This week's specials</a></p>
      {c.status === 'expired' && <div class="notice">These specials have finished.</div>}
      <div class="grid" style="margin-top:24px">{c.items.map((s) => <SpecialCard s={s} showDates />)}</div>
    </div>
  </section>
</Base>
