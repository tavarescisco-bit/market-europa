---
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Letterboard from '../components/Letterboard.astro';
import SpecialCard from '../components/SpecialCard.astro';
import ReelsWall from '../components/ReelsWall.astro';
import Subscribe from '../components/Subscribe.astro';
import { store, cafe, activeSeasonal, fmtDate } from '../lib/content';
import { u } from '../lib/url';
import { loadSpecials, liveSpecials, scheduledSpecials, campaigns, fmtRange } from '../lib/specials';

const all = loadSpecials();
const live = liveSpecials(all);
const main = campaigns(live).find((c) => c.items.some((i) => !i.liquor)) ?? campaigns(live)[0];
const next = scheduledSpecials(all)[0];
const preview = [...live.filter((i) => !i.liquor)].sort((a, b) => Number(b.isHero) - Number(a.isHero) || a.sortOrder - b.sortOrder).slice(0, 8);
const seasonal = activeSeasonal();
---
<Base title="European supermarket in Moorabbin" description="Market Europa Moorabbin: family-run European supermarket with deli and cheese, in-house butcher, fresh seafood, handmade pasta, bakery, imported groceries, liquor and a café. Weekly specials. Shop 5/444 Warrigal Road, Heatherton." current="/">
  <HeroVideo />
  <Letterboard />

  <section class="section" aria-labelledby="sp-title">
    <div class="container">
      <div class="section-head">
        <div><span class="eyebrow">{main ? fmtRange(main.start, main.end) : 'Weekly specials'}</span><h2 id="sp-title">This week's specials</h2></div>
        <p><a href={u('/specials')} data-event="specials_view">See all {live.length} specials</a></p>
      </div>
      {preview.length ? <div class="grid">{preview.map((s) => <SpecialCard s={s} />)}</div>
        : <div class="notice">This week's specials are in store now.{next && <> The next catalogue starts {fmtDate(next.start)}.</>}</div>}
    </div>
  </section>

  <div class="awning" aria-hidden="true"></div>

  <section class="section band-paper" aria-labelledby="dept-title">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">All under one roof</span><h2 id="dept-title">Shop by department</h2></div></div>
      <div class="tiles">
        {store.departments.map((d) => (
          <a class="tile" href={u(`/departments/${d.slug}`)}>
            {d.image && <img src={d.image} alt="" loading="lazy" decoding="async" width="600" height="450" />}
            <span class="t">{d.name}</span>
            <span class="s">{d.blurb}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ReelsWall />

  <section class="section band-bottle" aria-labelledby="cafe-title">
    <div class="container split">
      <div>
        <span class="eyebrow">Café</span>
        <h2 id="cafe-title">{cafe.subtitle}</h2>
        <p>{cafe.intro}</p>
        <p>Café hours: {store.cafeHours.map((h) => `${h.days} ${h.open} – ${h.close}`).join(' · ')}.</p>
        <a class="btn btn-light" href={u('/cafe')}>View the menu</a>
      </div>
      <div>
        <h3>Handmade every morning</h3>
        <p>Pasta and gnocchi are made in the market from the first mix to the final cut, and sold fresh at the counter or served at the gnocchi bar.</p>
        <p><a href={u('/departments/fresh-pasta')}>Fresh pasta and ready meals</a></p>
      </div>
    </div>
  </section>

  {seasonal && (
    <section class="section" aria-labelledby="season-title">
      <div class="container split">
        <div>
          <span class="eyebrow">{seasonal.eyebrow}</span>
          <h2 id="season-title">{seasonal.title}</h2>
          <p>{seasonal.intro}</p>
          {seasonal.cutoffDate && <p class="muted">Orders close {fmtDate(seasonal.cutoffDate, { weekday: 'long', day: 'numeric', month: 'long' })}.</p>}
          <a class="btn btn-bottle" href={u('/' + seasonal.key)}>{seasonal.key === 'christmas' ? 'Christmas pre-orders' : 'Find out more'}</a>
        </div>
        {seasonal.image && <img src={seasonal.image} alt="" loading="lazy" decoding="async" width="800" height="600" style="border-radius:10px" />}
      </div>
    </section>
  )}

  <section class="section band-paper" aria-labelledby="visit-title">
    <div class="container split">
      <div>
        <span class="eyebrow">Visit</span>
        <h2 id="visit-title">Moorabbin Super Centre, Warrigal Road</h2>
        <p>{store.address.line1}, {store.address.centre}, {store.address.locality} {store.address.region} {store.address.postcode}. {store.address.parking}.</p>
        <p><a class="btn btn-bottle" href={store.mapsUrl} rel="noopener" data-event="directions_click">Get directions</a></p>
        <p><a href={u('/visit')}>Hours, parking and public transport</a></p>
      </div>
      <Subscribe />
    </div>
  </section>
</Base>
