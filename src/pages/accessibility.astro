---
import Base from '../layouts/Base.astro';
---
<Base title="Accessibility" description="Accessibility statement for the Market Europa Moorabbin website." noindex>
  <div class="wrap section">
    <h1>Accessibility</h1>
    <p>This website is built to meet WCAG 2.2 Level AA. Specials and the café menu are published as text, not images, so they work with screen readers and can be zoomed. If anything on the site is hard to use, call the store on 03 9558 0755 and we will help and fix it.</p>
    <p>A printable version of each week's specials catalogue will be available from the specials page once the catalogue export is connected.</p>
  </div>
</Base>
