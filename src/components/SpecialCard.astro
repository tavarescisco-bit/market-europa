---
import type { Special } from '../lib/specials';
import { fmtRange } from '../lib/specials';
interface Props { s: Special; showDates?: boolean; listable?: boolean }
const { s, showDates = false, listable = false } = Astro.props;
const title = s.brand ? `${s.brand} ${s.name}` : s.name;
const initials = (s.brand || s.name).split(/\s+/).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('');
const amount = s.multibuy ? s.multibuy : s.priceLabel;
const [whole, cents] = (!s.multibuy && s.specialPrice != null) ? s.specialPrice.toFixed(2).split('.') : ['', ''];
---
<article class="card" id={s.id} data-dept={s.department} data-price={s.specialPrice ?? ''} data-search={`${title} ${s.origin} ${s.department}`.toLowerCase()}>
  <div class="photo">
    {s.imageUrl ? <img src={s.imageUrl} alt={`${title}${s.packSize ? ', ' + s.packSize : ''}`} loading="lazy" decoding="async" width="600" height="600" /> : <span class="initials" aria-hidden="true">{initials}</span>}
    <div class="ticket" aria-label={`${amount} ${s.priceSuffix}`.trim()}>
      <span class="amount">{whole ? <>${whole}<small>.{cents}</small></> : amount}</span>
      {s.priceSuffix && <span class="per">{s.priceSuffix === '/kg' ? 'per kg' : s.priceSuffix === '/dozen' ? 'per dozen' : s.priceSuffix}</span>}
      {s.regularPrice != null && s.specialPrice != null && s.regularPrice > s.specialPrice && <span class="was">was ${s.regularPrice.toFixed(2)}</span>}
    </div>
  </div>
  <div class="body">
    <div class="name">{title}</div>
    <div class="meta">{[s.packSize, s.unitPrice].filter(Boolean).join(' · ')}</div>
    {(s.origin || s.liquor) && <div>{s.origin && <span class="stamp">{s.origin}</span>} {s.liquor && <span class="stamp liquor">18+</span>}</div>}
    {(s.note || showDates) && <div class="meta">{[showDates ? fmtRange(s.start, s.end) : '', s.note].filter(Boolean).join(' · ')}</div>}
  </div>
  <div class="foot">
    <span class="dept">{s.department}</span>
    {listable && <button type="button" class="list-btn" data-list-add={s.id} data-list-label={`${title} ${amount} ${s.priceSuffix}`.trim()} aria-pressed="false">Add to my list</button>}
  </div>
</article>
